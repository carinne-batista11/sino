# Banco de dados: é gerado automaticamente ao rodar "python database.py".
# Nunca deve ir pro repositório — pode conter dados de teste ou reais.
sino.db

# Cache do Python (gerado automaticamente, também não precisa versionar)
__pycache__/
*.pyc

database/backups/

# Ambiente virtual do Python (criado localmente, ver README)
.venv/
