# Banco de dados: é gerado automaticamente ao rodar "python database.py".
# Nunca deve ir pro repositório — pode conter dados de teste ou reais.
sino.db

# Cache do Python (gerado automaticamente, também não precisa versionar)
__pycache__/
*.pyc

database/backups/

# Ambiente virtual do Python (criado localmente, ver README)
.venv/

# Serviço de códigos (servidor/): dependências, estado local do wrangler e
# segredos locais. Só o modelo .dev.vars.example vai para o repositório.
servidor/node_modules/
servidor/.wrangler/
servidor/.dev.vars
servidor/.dev.vars.*
!servidor/.dev.vars.example

# Arquivos de ambiente (.env), em qualquer pasta: o Wrangler e outras
# ferramentas os leem como segredos locais. Decisão 5 (15/10/2026).
.env
.env.*
