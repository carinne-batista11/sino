{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true
  },
  "include": ["./**/*.ts", "../../src/nucleo/**/*.ts", "../../src/envio/**/*.ts", "../../src/config.ts", "../../src/fluxos.ts", "../../src/http.ts", "../../src/acesso_teste.ts"]
}
