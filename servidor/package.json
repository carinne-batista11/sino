{
  "name": "sino-servico-codigos",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE",
  "description": "Serviço centralizado dos códigos de e-mail do Sino (ERS v6.0, Etapa 8): gera, envia e valida códigos e assina a autorização usada pelo app.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "test": "vitest run",
    "test:nucleo": "vitest run --project nucleo",
    "test:workers": "vitest run --project workers",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/nucleo/tsconfig.json"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20261001.1",
    "@types/node": "24.19.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.146.0"
  }
}
